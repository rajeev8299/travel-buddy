PORT=4000
# production: secure sign-in cookies and no Origin: null. Leave unset locally.
# NODE_ENV=production
# Browser origins allowed to call the API with cookies (comma-separated).
CLIENT_ORIGIN=http://localhost:5173
# Public base URL of this API, used in uploaded-image links. Defaults to the
# request's Host header, which is fine locally but should be set in production.
# PUBLIC_API_URL=https://api.example.com
# Set when the API sits behind a reverse proxy: number of proxy hops (e.g. 1).
# TRUST_PROXY=1
# Accept requests from file:// pages (Origin: null). Defaults to on outside
# production, off in production.
# ALLOW_FILE_ORIGIN=false
# At least 32 characters; the server refuses to start otherwise.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Creates the admin account on startup if no account uses ADMIN_EMAIL yet.
# Changing ADMIN_PASSWORD later does not change an existing account's password;
# use `npm run reset-password -- <email>` for that.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Enquiry notifications (all optional; see server/src/notify.js) ---------
# Email via any SMTP provider (Zoho, Gmail app password, Brevo, SES…)
# SMTP_URL=smtps://user:password@smtp.zoho.in:465
# MAIL_FROM="TravelOnBuddy <hello@travelonbuddy.in>"
# NOTIFY_EMAIL_TO=hello@travelonbuddy.in
# WhatsApp Cloud API: an approved template with 3 body variables
# ({{1}} kind, {{2}} reference, {{3}} name)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_NOTIFY_TO=919876543210
# WHATSAPP_TEMPLATE=new_enquiry
# WHATSAPP_TEMPLATE_LANG=en

# Encrypts buddy verification documents (64 hex characters). Without it,
# uploads are refused rather than stored unencrypted. Back it up: files
# can't be read without it. Generate with: openssl rand -hex 32
# BUDDY_DOCS_KEY=

# Lets the API refresh blog pages on the Next.js site straight away. Same
# long random value on both services.
# SITE_URL=https://www.yourdomain.in
# SITE_INTERNAL_URL=http://site:3000
# REVALIDATE_SECRET=
